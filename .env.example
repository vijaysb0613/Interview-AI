# Copy this file to .env and fill in real values. Never commit .env.

# --- Server-only secrets — never prefix with NEXT_PUBLIC_ ---
DATABASE_URL=
GEMINI_API_KEY=
CLERK_SECRET_KEY=

# --- Client-safe config ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_INTERVIEW_QUESTION_COUNT=5
NEXT_PUBLIC_QUESTION_NOTE=

# --- E2E testing only (npm run test:e2e) ---
# CLERK_SECRET_KEY/NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY above must point at a
# Clerk *test* instance for this. CLERK_E2E_TEST_EMAIL must be an existing
# user's email in that instance; the suite skips itself if unset.
# DATABASE_URL above should point at a separate Neon branch when running
# E2E (npm run test:e2e:seed truncates it before each run) - never point
# it at production. Gemini itself is mocked automatically (E2E_MOCK_GEMINI,
# set by playwright.config.ts), so no real Gemini key is needed for E2E.
CLERK_E2E_TEST_EMAIL=
